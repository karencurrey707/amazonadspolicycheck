    {
      "parameters": {
        "jsCode": "const html = $input.first().json.html || '';\nconst decode = (s) => s.replace(/&amp;/g, '&').replace(/&#39;/g, \"'\").replace(/&quot;/g, '\"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();\nconst re = /docs\\.google\\.com\\/document\\/d\\/([\\w-]+)[\\s\\S]*?flip-entry-title\">([^<]+)</g;\nconst seen = new Set();\nconst out = [];\nlet m;\nwhile ((m = re.exec(html)) !== null) {\n  if (seen.has(m[1])) continue;\n  seen.add(m[1]);\n  out.push({ json: { id: m[1], name: decode(m[2]) } });\n}\nif (out.length === 0) {\n  throw new Error('No Google Docs found. Check the folder ID and that the folder is shared as \"Anyone with the link\".');\n}\nreturn out;"
      },
