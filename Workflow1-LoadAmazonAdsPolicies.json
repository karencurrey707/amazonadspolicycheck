    {
      "parameters": {
        "jsCode": "// Breaks each policy doc into single sentences (each bullet line counts as one).\nconst out = [];\nfor (const item of $input.all()) {\n  const text = item.json.text || '';\n  const sentences = [];\n  for (const rawLine of text.split('\\n')) {\n    const line = rawLine.replace(/^\\s*[*\\-\\u2022]\\s*/, '').trim();\n    if (!line) continue;\n    const parts = line.split(/(?<=[.!?])\\s+(?=[A-Z0-9\"(\\u201C])/);\n    for (const p of parts) {\n      const s = p.trim();\n      if (s) sentences.push(s);\n    }\n  }\n  out.push({ json: { category: item.json.category, source_url: item.json.source_url, sentence_count: sentences.length, sentences } });\n}\nreturn out;"
      },
      "id": "6f9cf6ab-406c-44e0-9221-c699a3a3d919",
      "name": "Split Into Sentences",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.nebius_base_url }}/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Settings').first().json.embedding_model, input: $json.sentences, dimensions: $('Settings').first().json.embedding_dimensions }) }}",
        "options": {}
      },
      "id": "bc40e9a6-0af5-4324-83d4-496a6f04085f",
      "name": "Embed Each Sentence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1504,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "2w0bNQBKQxCS9s3u",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Walks through the sentences in order. Starts a new chunk when the next sentence\n// is not similar enough to the previous one (topic change), or the chunk would get too long.\nconst settings = $('Settings').first().json;\nconst threshold = Number(settings.semantic_threshold);\nconst maxChars = Number(settings.chunk_size);\nconst docs = $('Split Into Sentences').all();\nconst cosine = (a, b) => {\n  let dot = 0, na = 0, nb = 0;\n  for (let i = 0; i < a.length; i++) { dot += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i]; }\n  const denom = Math.sqrt(na) * Math.sqrt(nb);\n  return denom ? dot / denom : 0;\n};\nconst out = [];\n$input.all().forEach((resp, i) => {\n  const doc = docs[i].json;\n  const vectors = (resp.json.data || []).slice().sort((a, b) => a.index - b.index).map((d) => d.embedding);\n  const sentences = doc.sentences.slice(0, vectors.length);\n  if (sentences.length === 0) return;\n  let current = [sentences[0]];\n  let length = sentences[0].length;\n  let scores = [];\n  const pushChunk = (reason) => {\n    out.push({ json: { category: doc.category, source_url: doc.source_url, text: current.join('\\n'), sentence_count: current.length, similarities_inside: scores, ended_because: reason } });\n  };\n  for (let k = 1; k < sentences.length; k++) {\n    const sim = Number(cosine(vectors[k - 1], vectors[k]).toFixed(3));\n    const tooLong = length + 1 + sentences[k].length > maxChars;\n    if (sim < threshold || tooLong) {\n      pushChunk(sim < threshold ? 'topic change (similarity ' + sim + ')' : 'size limit');\n      current = [sentences[k]];\n      length = sentences[k].length;\n      scores = [];\n    } else {\n      current.push(sentences[k]);\n      length += 1 + sentences[k].length;\n      scores.push(sim);\n    }\n  }\n  pushChunk('end of document');\n});\nreturn out;"
      },
